# Zkopíruj do .env.local a vyplň.

# Neon Postgres – pro lokální vývoj použij samostatnou větev databáze, ne produkci
DATABASE_URL=

# API-Football (dashboard.api-football.com) – klíč z účtu, free tarif stačí na vývoj
API_FOOTBALL_KEY=
# Sezóna (2026 = 2026/27)
PL_SEASON=2026
# První kolo, od kterého se tipuje (dřívější se neimportují)
PL_FIRST_MATCHDAY=6

# Heslo pro /admin
ADMIN_TOKEN=

# Autentizace cronu / live syncu (stejná hodnota ve Vercelu a v GitHub secrets)
CRON_SECRET=

# E-maily (zapomenuté heslo) přes resend.com. Bez klíče se odkaz jen vypíše do terminálu (lokální vývoj).
# Ve výchozím stavu Resend pošle jen na e-mail majitele účtu – pro všechny je potřeba ověřená doména.
RESEND_API_KEY=
MAIL_FROM=PL Tipovačka <noreply@tvoje-domena.cz>

# Push upozornění (VAPID). Vygeneruj: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt provozovatele (e-mail), push služby ho mohou použít při potížích
VAPID_SUBJECT=mailto:tvuj@email.cz

# Veřejná adresa appky – NUTNÁ v produkci (odkaz v e-mailu pro nové heslo) (náhledy při sdílení) – volitelné
# NEXT_PUBLIC_SITE_URL=https://tvoje-domena.cz
